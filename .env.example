# Usado pelo docker-compose.yml pra testar Icecast + Liquidsoap +
# audio-bridge juntos na sua máquina. Copie pra ".env" na raiz do repo e
# preencha antes de rodar `docker compose up --build`.
# Em produção (Railway), cada uma dessas variáveis vai direto nas
# configurações do serviço correspondente — nunca num arquivo commitado.

# Senha que protege a entrada /live (o audio-bridge publica aqui; o
# Liquidsoap escuta aqui). Invente uma senha forte qualquer.
HARBOR_PASSWORD=troque-esta-senha

# Senha que o Liquidsoap usa pra publicar a saída /radio no Icecast —
# tem que ser IGUAL à <source-password> configurada no Icecast.
ICECAST_SOURCE_PASSWORD=troque-esta-outra-senha

# Senha de admin do painel web do Icecast (opcional de usar, mas obrigatória
# de definir).
ICECAST_ADMIN_PASSWORD=troque-esta-tambem

# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Só o audio-bridge usa esta (Project Settings → API → service_role) —
# NUNCA exponha essa chave num app de navegador, só em serviços de backend.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-secreta
