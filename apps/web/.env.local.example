# Copie este arquivo pra .env.local (nunca comite o .env.local de verdade).
# No Vercel, essas mesmas variáveis vão em Project Settings → Environment Variables.

# Painel do Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# URL pública do stream do Icecast (mount "/radio" — ver streaming/icecast/icecast.xml)
NEXT_PUBLIC_ICECAST_STREAM_URL=https://SEU-ICECAST.up.railway.app/radio

# URL pública (wss://) do audio-bridge no Railway
NEXT_PUBLIC_AUDIO_BRIDGE_WS_URL=wss://SEU-AUDIO-BRIDGE.up.railway.app
